import javax.swing.JFrame;
import javax.swing.JTextField;
import javax.swing.JLabel;
import javax.swing.JButton;
import java.awt.event.ActionListener;
import java.awt.GridLayout;

define celsius_fahrenheit_converter() {
  let celsius = JTextField();
  let fahrenheit = JLabel('Fahrenheit');
  let convert = JButton('Convert');

  convert.addActionListener {
    let c = double(celsius.text);
    fahrenheit.text = "${1.8*c+32} Fahrenheit";
  };

  JFrame().do {
    title = 'Celsius Converter'
    layout = GridLayout(2,2,3,3)
    defaultCloseOperation = JFrame.EXIT_ON_CLOSE
    add(celsius)
    add(JLabel('Celsius'))
    add(convert)
    add(fahrenheit)
    setSize(300, 80)
    visible = true
  }
}

celsius_fahrenheit_converter();
