class XMLBuilder {
  private root = null

  public void __invoke__(name, args...) {
    define doc = <$name/>
    define body = null

    for (i,key in args.keys) {
      if (!empty key)
        doc["@$key"] = args[i] // named attribute
      else
        body = args[i] // the body
    }

    if (body != null) {
      if (body is Closure) {
        define previous = root
        root = doc
        body(this)
        root = previous
      } else {
        doc.@@value = body
      }
    }

    if (root == null)
      root = doc
    else
      root[name] += doc
  }

  public toXML() => root
  public toString() => toXML().toString()
}

// --------------------------

define builder = XMLBuilder()

builder.book(isbn="999-99999-9-X") {
  $.title("Mary's XML Primer")
  $.author {
    $.firstName("Mary")
    $.lastName("White")
  }
  $.chapters {
    $.frontMatter {
      $.preface(pages="2")
      $.contents(pages="5")
      $.illustrations(pages="4")
    }
    $.chapter(number="1", pages="28", "XML Fundamentals")
    $.chapter(number="2", pages="35", "Intermediate XML")
    $.chapter(number="3", pages="44", "Advanced XML")
    $.appendix(number="A", pages="7", "Entities")
    $.appendix(number="B", pages="26", "Parsers and Tools")
  }
  $.media(type="CD")
}

print(builder.toXML())
