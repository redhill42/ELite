// ELite vs Python Performance Benchmark
// 用于和 Python 做性能对比

// ============ 1. 静态类型算术：斐波那契迭代 ============
define fib_iter(n) {
    define a = 0;
    define b = 1;
    for (i in [1..n]) {
        define c = a + b;
        a = b;
        b = c
    };
    b
}

// ============ 2. 静态类型算术：循环累加 ============
define sum_loop(n) {
    define s = 0;
    for (i in [1..n]) { s = s + i };
    s
}

// ============ 3. 静态类型算术：嵌套循环 ============
define nested_loop(n) {
    define s = 0;
    for (i in [1..n]) {
        for (j in [1..i]) {
            s = s + j
        }
    };
    s
}

// ============ 4. 递归（非尾递归）============
define fib_rec(n) {
    if (n <= 1) { n } else { fib_rec(n - 1) + fib_rec(n - 2) }
}

// ============ 5. 尾递归 ============
define fib_tail(n, a, b) {
    if (n <= 0) { a } else { fib_tail(n - 1, b, a + b) }
}

// ============ 6. 动态类型：列表操作 ============
define list_bench(n) {
    define result = [];
    for (i in [1..n]) {
        result = result ~ [i * i]
    };
    result
}

// ============ 7. 动态类型：字符串拼接 ============
define str_bench(n) {
    define s = "";
    for (i in [1..n]) {
        s = s ~ (i % 2 == 0 ? "E" : "O")
    };
    s.length
}

// ============ 8. 动态类型：map 操作 ============
define map_bench(n) {
    define m = {};
    for (i in [1..n]) {
        m[i] = i * i
    };
    m.size()
}

// ============ 执行入口 ============
define run_all(iters) {
    print("=== ELite Benchmark ===");
    print(fib_iter(iters * 1000));
    print(sum_loop(iters * 100000));
    print(nested_loop(iters * 10));
    print(fib_rec(iters));
    print(fib_tail(iters * 1000, 0, 1));
    print(list_bench(iters * 1000).size());
    print(str_bench(iters * 10000));
    print(map_bench(iters * 1000));
}
