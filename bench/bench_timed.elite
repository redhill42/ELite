// ELite benchmark with internal timing via Java System.nanoTime()
// Usage: bin/elite.sh bench/bench_timed.elite

define timeIt(label, iters, fn) {
    // Warmup
    for (i in [1..3]) { fn() };
    // Measure
    define start = java.lang.System.nanoTime();
    for (i in [1..iters]) { fn() };
    define elapsed = java.lang.System.nanoTime() - start;
    define ms = elapsed / 1000000.0 / iters;
    print(label ~ ": " ~ ms ~ " ms")
}

// ===== Static arithmetic =====
define fib_iter(n) {
    define a = 0; define b = 1;
    for (i in [1..n]) { define c = a + b; a = b; b = c };
    b
}

define sum_loop(n) {
    define s = 0;
    for (i in [1..n]) { s = s + i };
    s
}

define nested_loop(n) {
    define s = 0;
    for (i in [1..n]) {
        for (j in [1..i]) { s = s + j }
    };
    s
}

// ===== Recursion =====
define fib_rec(n) {
    if (n <= 1) { n } else { fib_rec(n - 1) + fib_rec(n - 2) }
}

define fib_tail(n, a, b) {
    if (n <= 0) { a } else { fib_tail(n - 1, b, a + b) }
}

// ===== Dynamic: list =====
define list_bench(n) {
    define result = [];
    for (i in [1..n]) { result = result ~ [i * i] };
    result
}

// ===== Dynamic: string =====
define str_bench(n) {
    define s = "";
    for (i in [1..n]) { s = s ~ (i % 2 == 0 ? "E" : "O") };
    s.length
}

// ===== Dynamic: map =====
define map_bench(n) {
    define m = {};
    for (i in [1..n]) { m[i] = i * i };
    m.size
}

// ===== Run benchmarks =====
define N = 20;

print("=== ELite Benchmark (n=" ~ N ~ ") ===");
print("");

timeIt("fib_iter  ", 50,  \=> fib_iter(N * 1000));
timeIt("sum_loop  ", 50,  \=> sum_loop(N * 100000));
timeIt("nested_lp ", 50,  \=> nested_loop(N * 10));
timeIt("fib_rec   ", 20,  \=> fib_rec(N));
timeIt("fib_tail  ", 50,  \=> fib_tail(N * 1000, 0, 1));
timeIt("list_bench", 50,  \=> list_bench(N * 1000));
timeIt("str_bench ", 20,  \=> str_bench(N * 1000));
timeIt("map_bench ", 50,  \=> map_bench(N * 1000));
